# Copy to .env and fill in. Never commit .env.
PORT=3000
# Where the SQLite file lives (created on first run)
DB_FILE=./data/gym-bruhs.sqlite
# PIN for the /staff screen. Required for staff sign-in.
STAFF_PIN=
# Sales tax as a decimal, e.g. 0.078 for 7.8%. 0 = no tax line.
TAX_RATE=0
# Public URL of the app, used inside QR codes and Stripe redirects, e.g. https://gymbruhs.example.com
BASE_URL=
# Stripe (https://dashboard.stripe.com/apikeys). Leave empty to offer "pay at counter" only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to 1 ONLY for local demos: adds a fake "simulate card payment" button. Never in production.
DEMO_PAYMENTS=0
